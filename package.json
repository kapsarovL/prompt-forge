    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
