{
  "name": "prompt-forge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "description": "A client-side prompt engineering workspace — craft, refine, evaluate, and optimize LLM prompts entirely in the browser.",
