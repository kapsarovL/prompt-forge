# Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=

# Paddle Configuration
# Get your API key from: https://vendors.paddle.com/developer-settings
# (must start with pdl_live_ or pdl_dev_)
PADDLE_API_KEY=
# Webhook signing secret (separate from API key) — from Paddle Dashboard > Webhooks
PADDLE_WEBHOOK_SECRET=
# "live" or "sandbox"
PADDLE_ENV=live
# Your Paddle seller (vendor) ID — from Paddle Dashboard > Business Info
NEXT_PUBLIC_PADDLE_SELLER_ID=your_seller_id
# Client-side token (prefixed live_ or test_) — from Paddle Dashboard > Developer Tools > Authorization
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# One-time price ID (legacy single-tier)
NEXT_PUBLIC_PADDLE_PRICE_ID=

# 3-tier subscription price IDs — created via scripts/create-paddle-prices.ts
NEXT_PUBLIC_PRICE_ID_STARTER_MONTH=
NEXT_PUBLIC_PRICE_ID_STARTER_YEAR=
NEXT_PUBLIC_PRICE_ID_PRO_MONTH=
NEXT_PUBLIC_PRICE_ID_PRO_YEAR=
NEXT_PUBLIC_PRICE_ID_ADVANCED_MONTH=
NEXT_PUBLIC_PRICE_ID_ADVANCED_YEAR=

# Neon Postgres
# Get your connection string from: https://console.neon.tech
DATABASE_URL=
