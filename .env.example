# Gemini API Key
# Get your key from: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=

# Content Security Policy: CDN origins for deployed assets
# Set to the CDN origin(s) that serve Next.js static assets (fonts, CSS, JS)
# Example: https://*.cosmic.webflow.services
# Multiple origins: space-separated
CSP_ASSET_ORIGINS=
